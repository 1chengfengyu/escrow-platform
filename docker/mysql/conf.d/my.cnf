[mysqld]
# 内存预算按 VM 6 GB 定（docs/02 第四节）：MySQL 控制在 ~500 MB，不挤占 Redis。
innodb_buffer_pool_size = 256M
innodb_redo_log_capacity = 128M
max_connections         = 100

# 字符集与排序规则必须和 DDL 的 utf8mb4_0900_ai_ci 一致
character-set-server    = utf8mb4
collation-server        = utf8mb4_0900_ai_ci

# 和 JDBC 串里的 serverTimezone=Asia/Shanghai 对齐，避免时间比较偏 8 小时
default-time-zone       = '+08:00'

# 必须保持 1：每次提交都刷盘。改成 2 能快 3 倍，但崩溃会丢最近 1 秒的已提交事务，
# 资金系统不可接受。禁止以"优化"为名改这一行。
innodb_flush_log_at_trx_commit = 1

[client]
default-character-set = utf8mb4