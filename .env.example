# 复制成 .env 后按需修改。不建 .env 也能跑：compose 与 application.yml 都带本地演示默认值。
# 这些口令只用于本地演示，不得用于任何真实环境。

# 口令一律留空时使用本地演示默认值。真实口令只写在本地 .env（已在 .gitignore 中），不得提交。

# MySQL
MYSQL_ROOT_PASSWORD=
DB_NAME=escrow
DB_USERNAME=escrow
DB_PASSWORD=

# Redis
REDIS_PASSWORD=

# 数据库 / 缓存不在本机时，指向实际主机
# DB_HOST=127.0.0.1
# REDIS_HOST=127.0.0.1

# Kafka：broker 对外宣告的地址必须是客户端能连到的值
# KAFKA_ADVERTISED_HOST=127.0.0.1
# 应用侧 bootstrap 地址，不填默认 127.0.0.1:9092
# KAFKA_BOOTSTRAP=127.0.0.1:9092

# Nacos 3.x：即使关闭鉴权也要求 token / identity 存在。
# 不填时用 compose 里的官方演示默认值；对外部署必须换成随机值。
# NACOS_AUTH_TOKEN=<Base64，不少于 32 字节>
# NACOS_AUTH_IDENTITY_KEY=<自定义 key>
# NACOS_AUTH_IDENTITY_VALUE=<自定义 value>

# 演示与端到端校验脚本（scripts/demo-*.ps1、scripts/verify-*.ps1）从这里读取账号口令。
# 先注册演示账号，再用同一个口令填入本项。
ESCROW_DEMO_PASSWORD=